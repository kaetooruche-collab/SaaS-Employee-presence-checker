# In production (Vercel + Neon), both of these are set automatically by the
# Neon integration once connected to the project — DATABASE_URL_UNPOOLED is
# Neon's own name for the direct/migrate connection, not a placeholder.
DATABASE_URL="postgresql://postgres:devpassword@localhost:5432/presence_dev?schema=public"
DATABASE_URL_UNPOOLED="postgresql://postgres:devpassword@localhost:5432/presence_dev?schema=public"
SESSION_SECRET="change-me-in-production"
PORT=3000

# Required in production (Vercel) for the /api/cron/* endpoints to accept
# requests — Vercel automatically sends this as a Bearer token on scheduled
# cron invocations once the env var is set. Generate any random string.
CRON_SECRET=""

# OTP_CHANNEL selects the sender in src/services/otp.ts: "console" (default,
# logs the code instead of sending it — fine for local dev) or "whatsapp"
# (real delivery via Meta's WhatsApp Cloud API, requires the vars below).
OTP_CHANNEL="console"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_OTP_TEMPLATE_NAME=""

